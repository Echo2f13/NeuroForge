# NeuroForge — Environment Variables
# Copy this file to .env and fill in your API keys.
# All services below offer free tiers sufficient for development.

# === Groq (Primary LLM) ===
# Sign up: https://console.groq.com/
# Free tier: 30 req/min, 14,400 req/day
GROQ_API_KEY=your_groq_api_key_here

# === OpenRouter (Fallback LLM) ===
# Sign up: https://openrouter.ai/
# Free tier: varies by model (~20 req/min for free models)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# === Ollama (Local LLM for Knowledge Extraction) ===
# Used for the most critical AI task: extracting concepts and relationships from documents
# This runs on your local Ollama server for best quality knowledge extraction
# Default model: qwen2.5-coder:7b (best balance of quality and speed)
# 
# Set OLLAMA_BASE_URL to your Ollama server's OpenAI-compatible endpoint
# Example for local: http://localhost:11434/v1
# Example for remote: http://100.95.121.45:11434/v1
OLLAMA_BASE_URL=http://localhost:11434/v1

# Optional: Specify which Ollama model to use for knowledge extraction
# Available models depend on your Ollama installation
# Recommended: qwen2.5-coder:7b (7B params, 32k context, great for extraction)
# OLLAMA_MODEL=qwen2.5-coder:7b

# === Optional: LangSmith (Tracing/Observability) ===
# Sign up: https://smith.langchain.com/
# Free tier: 5,000 traces/month
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=your_langsmith_api_key_here
# LANGCHAIN_PROJECT=neuroforge
